---
// ponytail: Dynamic post page with server-rendered KaTeX & Shiki, zero client bundle bloat
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ReaderNotes from '../../components/ReaderNotes.astro';
import ShareBar from '../../components/ShareBar.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ReadingPill from '../../components/ReadingPill.astro';
import { CATEGORIES } from '../../utils/categories';
import { getReadingTime } from '../../utils/readingTime';
import { Bookmark, Languages } from 'lucide-astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const readingTime = getReadingTime(post.body);

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const currentIndex = sortedPosts.findIndex(p => p.slug === post.slug);
const prevPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;

const fontClassMap = {
  sans: 'mode-sans',
  academic: 'mode-academic',
  serif: 'mode-serif',
};
const defaultFontClass = fontClassMap[post.data.recommendedFont || 'sans'];
---

<BaseLayout title={post.data.title} description={post.data.description} ogType="article">
  {post.data.translationSlug && (
    <meta name="translation-url" content={`/posts/${post.data.translationSlug}/`} slot="head" />
  )}
  <div class="space-y-6">
    
    <!-- Reusable Breadcrumbs Navigation Map & Back Link -->
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: CATEGORIES[post.data.category]?.label || post.data.category, href: `/category/${post.data.category}` },
        { label: post.data.title }
      ]}
      backLink={{ label: 'All posts', href: '/' }}
    />

    <!-- 12-Column Grid: 8 cols Article Canvas (Expanded max 840px) + 4 cols Sticky TOC -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-14">
      
      <!-- Main Reading Column (8 cols = 66.6%) -->
      <article class={`card-surface md:col-span-8 p-5 sm:p-10 lg:p-14 shadow-xl max-w-[840px] w-full mx-auto md:mx-0 rounded-2xl sm:rounded-3xl ${defaultFontClass}`}>
        
        <!-- Header (F-Pattern Left Anchored with generous spacing) -->
        <header class="space-y-6 border-b border-subtle pb-8">
          <div class="space-y-2.5 text-xs text-text-muted font-mono">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <CategoryBadge category={post.data.category} />

              {post.data.translationSlug && (
                <a
                  href={`/posts/${post.data.translationSlug}/`}
                  class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono border border-subtle bg-slate-100 dark:bg-slate-800 hover:border-accent-primary dark:hover:border-accent-primaryDark text-slate-800 dark:text-slate-200 transition-all shadow-sm shrink-0 whitespace-nowrap"
                  title={post.data.lang === 'vi' ? 'Read English translation' : 'Đọc bản Tiếng Việt'}
                >
                  <Languages class="w-3.5 h-3.5 text-accent-primary dark:text-accent-primaryDark" />
                  <span>{post.data.lang === 'vi' ? 'English Edition →' : 'Bản Tiếng Việt →'}</span>
                </a>
              )}
            </div>

            <div class="flex items-center gap-2 text-[11px] text-text-muted whitespace-nowrap">
              <time datetime={post.data.publishDate.toISOString()} class="whitespace-nowrap">
                {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
              <span class="text-slate-300 dark:text-slate-600">&bull;</span>
              <span class="whitespace-nowrap">{readingTime}</span>
            </div>
          </div>

          <!-- Title with Vietnamese Stacked Diacritics Protection (Clamped 26px - 36px) -->
          <h1 class="article-title font-bold text-slate-900 dark:text-white">
            {post.data.title}
          </h1>

          <p class="article-body-p text-text-muted">
            {post.data.description}
          </p>

          {post.data.tags && post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5 pt-2">
              {post.data.tags.map(tag => (
                <span class="text-xs font-mono text-slate-600 dark:text-slate-400 bg-slate-100 dark:bg-slate-800/80 px-2.5 py-0.5 rounded-md border border-subtle">
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </header>

        <!-- Article Body with Native Server-Rendered KaTeX & Shiki Syntax (No space-y-4 conflict) -->
        <div class="prose dark:prose-invert max-w-none text-slate-800 dark:text-slate-200">
          <Content />
        </div>

        <!-- 1-Click Social Share Bar -->
        <ShareBar title={post.data.title} />

        <!-- Next & Previous Post Navigation (Flow Continuity) -->
        {(prevPost || nextPost) && (
          <nav class="pt-8 mt-8 border-t border-subtle grid grid-cols-1 sm:grid-cols-2 gap-4" aria-label="Post navigation">
            {prevPost ? (
              <a
                href={`/posts/${prevPost.slug}`}
                class="p-4 rounded-2xl border border-subtle bg-slate-50/50 dark:bg-slate-900/40 hover:border-accent-primary dark:hover:border-accent-primaryDark transition-all group flex flex-col justify-between"
              >
                <div class="text-[11px] font-mono text-text-muted flex items-center gap-1 group-hover:text-accent-primary dark:group-hover:text-accent-primaryDark transition-colors">
                  &larr; <span>Previous post</span>
                </div>
                <div class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white mt-1.5 line-clamp-2">
                  {prevPost.data.title}
                </div>
              </a>
            ) : <div />}

            {nextPost ? (
              <a
                href={`/posts/${nextPost.slug}`}
                class="p-4 rounded-2xl border border-subtle bg-slate-50/50 dark:bg-slate-900/40 hover:border-accent-primary dark:hover:border-accent-primaryDark transition-all group flex flex-col justify-between text-right"
              >
                <div class="text-[11px] font-mono text-text-muted flex items-center justify-end gap-1 group-hover:text-accent-primary dark:group-hover:text-accent-primaryDark transition-colors">
                  <span>Next post</span> &rarr;
                </div>
                <div class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white mt-1.5 line-clamp-2">
                  {nextPost.data.title}
                </div>
              </a>
            ) : <div />}
          </nav>
        )}

      </article>

      <!-- Desktop Sidebar Column (4 cols = 33.3%, hidden on mobile to avoid redundant footer clutter) -->
      <aside class="hidden md:block md:col-span-4" id="post-sidebar">
        
        <div id="sticky-sidebar-wrapper" class="sticky top-24 space-y-4">
          <!-- Smart Table of Contents (Click-to-expand, placed on top as requested) -->
          <TableOfContents headings={headings} />

          <!-- Reader's Personal Notes Card (Placed below TOC, auto-opens & captures keyboard typing) -->
          <ReaderNotes slug={post.slug} title={post.data.title} />
        </div>

      </aside>

    </div>

  </div>

  <!-- Mobile Floating Reading Pill HUD -->
  <ReadingPill headings={headings} title={post.data.title} slug={post.slug} />

  <!-- Client-side Lightweight Mermaid Renderer & Code Block Enhancer -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Enhanced Copy Button & Language Badge for Code Blocks
      document.querySelectorAll('pre.astro-code').forEach(pre => {
        // Detect language
        const langAttr = pre.getAttribute('data-language');
        const codeEl = pre.querySelector('code');
        const langMatch = pre.className.match(/language-([a-z0-9_-]+)/i) || codeEl?.className.match(/language-([a-z0-9_-]+)/i);
        const language = langAttr || (langMatch ? langMatch[1] : '');

        if (language && language !== 'plaintext' && language !== 'text') {
          const badge = document.createElement('span');
          badge.className = 'code-lang-badge';
          badge.textContent = language.toUpperCase();
          pre.appendChild(badge);
        }

        const copyBtn = document.createElement('button');
        copyBtn.className = 'copy-code-btn';
        copyBtn.innerHTML = `
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          <span class="copy-label">Copy</span>
        `;
        copyBtn.title = 'Copy code';
        copyBtn.setAttribute('aria-label', 'Copy code');
        
        pre.appendChild(copyBtn);

        copyBtn.addEventListener('click', async () => {
          const code = codeEl?.innerText || pre.innerText;
          let success = false;
          if (navigator.clipboard && window.isSecureContext) {
            try {
              await navigator.clipboard.writeText(code);
              success = true;
            } catch (err) {}
          }
          if (!success) {
            const ta = document.createElement('textarea');
            ta.value = code;
            ta.style.position = 'fixed';
            ta.style.left = '-999999px';
            document.body.appendChild(ta);
            ta.focus();
            ta.select();
            try {
              success = document.execCommand('copy');
            } catch (err) {}
            ta.remove();
          }

          if (success) {
            copyBtn.innerHTML = `
              <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <span class="text-emerald-400 font-semibold">Copied!</span>
            `;
            setTimeout(() => {
              copyBtn.innerHTML = `
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                <span class="copy-label">Copy</span>
              `;
            }, 2000);
          } else {
            copyBtn.querySelector('.copy-label').textContent = 'Failed';
          }
        });
      });

      // Mermaid Diagrams with Interactive Controls & Theme Reactivity
      let mermaidInstance = null;
      const mermaidContainers = [];

      const initialCodeBlocks = Array.from(document.querySelectorAll('pre code, pre'));
      const mermaidBlocks = initialCodeBlocks.filter(el => {
        return el.classList.contains('language-mermaid') || 
               el.textContent?.trim().startsWith('flowchart') || 
               el.textContent?.trim().startsWith('graph') ||
               el.textContent?.trim().startsWith('sequenceDiagram');
      });

      if (mermaidBlocks.length > 0) {
        import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs').then(m => {
          mermaidInstance = m.default;

          async function renderAllMermaid() {
            if (!mermaidInstance) return;
            const isDark = document.documentElement.classList.contains('dark');
            mermaidInstance.initialize({
              startOnLoad: false,
              theme: isDark ? 'dark' : 'neutral',
              fontFamily: 'Be Vietnam Pro, sans-serif'
            });

            for (let i = 0; i < mermaidContainers.length; i++) {
              const item = mermaidContainers[i];
              try {
                const id = `mermaid-svg-${Date.now()}-${i}`;
                const { svg } = await mermaidInstance.render(id, item.rawCode);
                item.canvas.innerHTML = svg;
              } catch (err) {
                console.warn('Mermaid re-render failed:', err);
              }
            }
          }

          // Initial Render & Interactive Workstation Setup
          mermaidBlocks.forEach(async (el, idx) => {
            const rawCode = el.textContent || '';
            const parent = el.closest('pre') || el;
            
            // Build interactive wrapper
            const wrapper = document.createElement('div');
            wrapper.className = 'mermaid-interactive-wrapper';

            const toolbar = document.createElement('div');
            toolbar.className = 'mermaid-toolbar';
            toolbar.innerHTML = `
              <div class="mermaid-toolbar-title">
                <span>Diagram View</span>
                <span class="mermaid-status-badge zoom-badge">100%</span>
                <span class="mermaid-status-badge rot-badge">0°</span>
              </div>
              <div class="mermaid-toolbar-controls">
                <button type="button" class="mermaid-btn btn-zoom-in" title="Zoom In (+)">+</button>
                <button type="button" class="mermaid-btn btn-zoom-out" title="Zoom Out (−)">−</button>
                <button type="button" class="mermaid-btn btn-rot-left" title="Rotate Left 90°">↶</button>
                <button type="button" class="mermaid-btn btn-rot-right" title="Rotate Right 90°">↷</button>
                <button type="button" class="mermaid-btn btn-reset" title="Reset View">1:1</button>
                <button type="button" class="mermaid-btn btn-fullscreen" title="Toggle Fullscreen">Max</button>
              </div>
            `;

            const viewport = document.createElement('div');
            viewport.className = 'mermaid-viewport';

            const canvas = document.createElement('div');
            canvas.className = 'mermaid-canvas';

            viewport.appendChild(canvas);
            wrapper.appendChild(toolbar);
            wrapper.appendChild(viewport);
            parent.replaceWith(wrapper);

            // Pan, Zoom, Rotate state management
            let scale = 1.0;
            let posX = 0;
            let posY = 0;
            let rotation = 0;
            let isDragging = false;
            let startX = 0;
            let startY = 0;

            const zoomBadge = toolbar.querySelector('.zoom-badge');
            const rotBadge = toolbar.querySelector('.rot-badge');

            function updateTransform() {
              canvas.style.transform = `translate(${posX}px, ${posY}px) rotate(${rotation}deg) scale(${scale})`;
              if (zoomBadge) zoomBadge.textContent = `${Math.round(scale * 100)}%`;
              if (rotBadge) rotBadge.textContent = `${rotation}°`;
            }

            toolbar.querySelector('.btn-zoom-in')?.addEventListener('click', () => {
              scale = Math.min(scale + 0.2, 3.5);
              updateTransform();
            });
            toolbar.querySelector('.btn-zoom-out')?.addEventListener('click', () => {
              scale = Math.max(scale - 0.2, 0.4);
              updateTransform();
            });
            toolbar.querySelector('.btn-rot-left')?.addEventListener('click', () => {
              rotation = (rotation - 90 + 360) % 360;
              updateTransform();
            });
            toolbar.querySelector('.btn-rot-right')?.addEventListener('click', () => {
              rotation = (rotation + 90) % 360;
              updateTransform();
            });
            toolbar.querySelector('.btn-reset')?.addEventListener('click', () => {
              scale = 1.0;
              posX = 0;
              posY = 0;
              rotation = 0;
              updateTransform();
            });
            toolbar.querySelector('.btn-fullscreen')?.addEventListener('click', () => {
              wrapper.classList.toggle('is-fullscreen');
            });

            // Dragging viewport
            viewport.addEventListener('mousedown', (e) => {
              if (e.button !== 0) return;
              isDragging = true;
              startX = e.clientX - posX;
              startY = e.clientY - posY;
            });
            window.addEventListener('mousemove', (e) => {
              if (!isDragging) return;
              posX = e.clientX - startX;
              posY = e.clientY - startY;
              updateTransform();
            });
            window.addEventListener('mouseup', () => {
              isDragging = false;
            });

            // Wheel zoom
            viewport.addEventListener('wheel', (e) => {
              e.preventDefault();
              const delta = e.deltaY < 0 ? 0.15 : -0.15;
              scale = Math.min(Math.max(scale + delta, 0.4), 3.5);
              updateTransform();
            }, { passive: false });

            // Touch support
            let initialTouchDist = null;
            let initialScale = 1.0;
            viewport.addEventListener('touchstart', (e) => {
              if (e.touches.length === 1) {
                isDragging = true;
                startX = e.touches[0].clientX - posX;
                startY = e.touches[0].clientY - posY;
              } else if (e.touches.length === 2) {
                isDragging = false;
                initialTouchDist = Math.hypot(
                  e.touches[0].clientX - e.touches[1].clientX,
                  e.touches[0].clientY - e.touches[1].clientY
                );
                initialScale = scale;
              }
            }, { passive: true });

            viewport.addEventListener('touchmove', (e) => {
              if (e.touches.length === 1 && isDragging) {
                posX = e.touches[0].clientX - startX;
                posY = e.touches[0].clientY - startY;
                updateTransform();
              } else if (e.touches.length === 2 && initialTouchDist) {
                const currentDist = Math.hypot(
                  e.touches[0].clientX - e.touches[1].clientX,
                  e.touches[0].clientY - e.touches[1].clientY
                );
                scale = Math.min(Math.max(initialScale * (currentDist / initialTouchDist), 0.4), 3.5);
                updateTransform();
              }
            }, { passive: true });

            viewport.addEventListener('touchend', () => {
              isDragging = false;
              initialTouchDist = null;
            });

            const record = { canvas, rawCode };
            mermaidContainers.push(record);

            try {
              const isDark = document.documentElement.classList.contains('dark');
              mermaidInstance.initialize({
                startOnLoad: false,
                theme: isDark ? 'dark' : 'neutral',
                fontFamily: 'Be Vietnam Pro, sans-serif'
              });
              const { svg } = await mermaidInstance.render(`mermaid-svg-${idx}`, rawCode);
              canvas.innerHTML = svg;
            } catch (err) {
              console.warn('Initial Mermaid render error:', err);
            }
          });

          // Listen for theme toggle to re-render diagrams in synced theme
          document.getElementById('global-theme-btn')?.addEventListener('click', () => {
            setTimeout(renderAllMermaid, 60);
          });

        }).catch(err => console.warn('Could not load Mermaid:', err));
      }

      // ==============================================================================
      // Interactive Reader Selection Highlighter Toolbar
      // ==============================================================================
      const proseArticle = document.querySelector('article .prose');
      if (proseArticle) {
        const hlToolbar = document.createElement('div');
        hlToolbar.className = 'reader-highlight-toolbar hidden';
        hlToolbar.innerHTML = `
          <button type="button" class="hl-tool-btn btn-hl-yellow" data-action="hl-focus" title="Highlight Yellow (Focus, Bold, Italic, Underline, Pop)">Yellow</button>
          <button type="button" class="hl-tool-btn btn-hl-red" data-action="hl-warn" title="Highlight Red (Warning, Wave Underline, Pop)">Alert</button>
          <button type="button" class="hl-tool-btn btn-hl-blue" data-action="hl-key" title="Highlight Indigo (Key Concept, Dashed Underline, Pop)">Key</button>
          <button type="button" class="hl-tool-btn btn-hl-note" data-action="add-note" title="Send to Reading Notes">Note</button>
        `;
        document.body.appendChild(hlToolbar);

        let currentRange = null;

        document.addEventListener('selectionchange', () => {
          const sel = window.getSelection();
          if (!sel || sel.isCollapsed || !sel.rangeCount) {
            hlToolbar.classList.add('hidden');
            currentRange = null;
            return;
          }

          const range = sel.getRangeAt(0);
          if (!proseArticle.contains(range.commonAncestorContainer)) {
            hlToolbar.classList.add('hidden');
            currentRange = null;
            return;
          }

          const text = sel.toString().trim();
          if (text.length < 2) {
            hlToolbar.classList.add('hidden');
            currentRange = null;
            return;
          }

          currentRange = range.cloneRange();
          const rect = range.getBoundingClientRect();
          hlToolbar.style.top = `${rect.top + window.scrollY}px`;
          hlToolbar.style.left = `${rect.left + window.scrollX + rect.width / 2}px`;
          hlToolbar.classList.remove('hidden');
        });

        hlToolbar.addEventListener('mousedown', (e) => {
          e.preventDefault();
        });

        hlToolbar.addEventListener('click', (e) => {
          const btn = e.target.closest('.hl-tool-btn');
          if (!btn || !currentRange) return;
          const action = btn.getAttribute('data-action');

          if (action === 'add-note') {
            const selectedText = currentRange.toString().trim();
            const textarea = document.getElementById('reader-notes-textarea');
            if (textarea) {
              const val = textarea.value;
              const separator = val.length > 0 ? '\n\n' : '';
              textarea.value = val + separator + `> "${selectedText}"\n`;
              textarea.dispatchEvent(new Event('input', { bubbles: true }));
              const notesCard = document.getElementById('reader-notes-card');
              if (notesCard?.classList.contains('notes-is-collapsed')) {
                document.getElementById('notes-header')?.click();
              }
            }
            window.getSelection()?.removeAllRanges();
            hlToolbar.classList.add('hidden');
            return;
          }

          if (action === 'hl-focus' || action === 'hl-warn' || action === 'hl-key') {
            try {
              const mark = document.createElement('mark');
              mark.className = action;
              currentRange.surroundContents(mark);
            } catch (err) {
              const mark = document.createElement('mark');
              mark.className = action;
              mark.textContent = currentRange.toString();
              currentRange.deleteContents();
              currentRange.insertNode(mark);
            }
            window.getSelection()?.removeAllRanges();
            hlToolbar.classList.add('hidden');
          }
        });

        document.addEventListener('mousedown', (e) => {
          if (!hlToolbar.contains(e.target)) {
            hlToolbar.classList.add('hidden');
          }
        });
      }
    });
  </script>
</BaseLayout>
