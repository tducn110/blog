---
// ponytail: Accessible, ergonomic Mobile Reading HUD (Floating Pill) with scroll-aware auto-hide, TOC bottom sheet, personal notes, and social share
import { BookOpen, Share2, ArrowUp, Check, X, PenLine, Copy, Trash2 } from 'lucide-astro';

interface Props {
  headings?: { depth: number; slug: string; text: string }[];
  title?: string;
  slug?: string;
}

const { headings = [], title = '', slug = '' } = Astro.props;
const filteredHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

<!-- Mobile Floating Reading Pill (< md screens) -->
<aside
  id="reading-pill-container"
  class="fixed z-40 left-1/2 -translate-x-1/2 bottom-[calc(1rem+env(safe-area-inset-bottom,0px))] md:hidden transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
  aria-label="Reading controls"
>
  <div class="relative flex items-center gap-0.5 px-2 py-1.5 rounded-full shadow-2xl backdrop-blur-xl bg-slate-900/90 dark:bg-slate-950/90 text-white border border-white/15 dark:border-slate-800 ring-1 ring-black/10 select-none">
    
    <!-- Micro Reading Progress Bar embedded on top rim of the pill -->
    <div class="absolute -top-[1px] left-4 right-4 h-[2px] bg-white/10 dark:bg-white/5 rounded-full overflow-hidden pointer-events-none">
      <div id="pill-progress-fill" class="h-full bg-accent-primary dark:bg-accent-primaryDark transition-all duration-100 ease-out w-0"></div>
    </div>

    <!-- 1. Table of Contents Trigger (if article has sections) -->
    {filteredHeadings.length > 0 && (
      <>
        <button
          id="pill-toc-btn"
          type="button"
          class="pill-action-btn flex items-center gap-1.5 px-2.5 py-1.5 rounded-full text-xs font-semibold text-slate-200 hover:text-white hover:bg-white/10 transition-colors"
          aria-label={`Table of contents (${filteredHeadings.length} sections)`}
          aria-expanded="false"
          aria-controls="pill-toc-sheet"
        >
          <BookOpen class="w-3.5 h-3.5 text-accent-primary dark:text-accent-primaryDark shrink-0" />
          <span class="text-[11px] font-mono tracking-tight">TOC</span>
          <span class="text-[9px] font-mono opacity-60 bg-white/15 px-1 py-0.2 rounded-full">{filteredHeadings.length}</span>
        </button>
        <span class="w-px h-3.5 bg-white/15 mx-0.5" aria-hidden="true"></span>
      </>
    )}

    <!-- 2. Personal Notes Trigger (if slug provided) -->
    {slug && (
      <>
        <button
          id="pill-notes-btn"
          type="button"
          class="pill-action-btn flex items-center gap-1.5 px-2.5 py-1.5 rounded-full text-xs font-semibold text-slate-200 hover:text-white hover:bg-white/10 transition-colors"
          aria-label="Open personal reading notes"
          aria-expanded="false"
          aria-controls="pill-notes-sheet"
        >
          <PenLine class="w-3.5 h-3.5 text-accent-primary dark:text-accent-primaryDark shrink-0" />
          <span class="text-[11px] font-mono tracking-tight">Note</span>
        </button>
        <span class="w-px h-3.5 bg-white/15 mx-0.5" aria-hidden="true"></span>
      </>
    )}

    <!-- 3. Share / Copy Link with Animated Confirmation -->
    <button
      id="pill-share-btn"
      type="button"
      class="pill-action-btn p-2 rounded-full text-slate-200 hover:text-white hover:bg-white/10 transition-colors relative"
      aria-label="Copy post link"
      title="Copy post link"
    >
      <Share2 class="w-3.5 h-3.5 share-default-icon" />
      <Check class="w-3.5 h-3.5 text-emerald-400 share-success-icon hidden" />
    </button>

    <span class="w-px h-3.5 bg-white/15 mx-0.5" aria-hidden="true"></span>

    <!-- 5. Scroll to Top -->
    <button
      id="pill-top-btn"
      type="button"
      class="pill-action-btn p-2 rounded-full text-slate-200 hover:text-white hover:bg-white/10 transition-colors"
      aria-label="Scroll to top of article"
      title="Scroll to top"
    >
      <ArrowUp class="w-3.5 h-3.5" />
    </button>

  </div>
</aside>

<!-- Mobile TOC Bottom Sheet Modal (Drawer) -->
{filteredHeadings.length > 0 && (
  <div
    id="pill-toc-sheet"
    class="fixed inset-0 z-50 pointer-events-none opacity-0 transition-opacity duration-200 ease-out md:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Article Table of Contents"
    aria-hidden="true"
  >
    <!-- Dark Backdrop Overlay -->
    <div id="pill-toc-backdrop" class="absolute inset-0 bg-slate-950/70 backdrop-blur-sm"></div>

    <!-- Sheet Surface Container -->
    <div
      id="pill-toc-surface"
      class="absolute bottom-0 inset-x-0 max-h-[75vh] bg-[var(--surface-card)] rounded-t-3xl border-t border-subtle shadow-2xl p-5 pb-[calc(1.5rem+env(safe-area-inset-bottom,0px))] flex flex-col transform translate-y-full transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
    >
      <!-- Sheet Header -->
      <div class="flex items-center justify-between pb-3 border-b border-subtle shrink-0">
        <div class="flex items-center gap-2">
          <BookOpen class="w-4 h-4 text-accent-primary dark:text-accent-primaryDark" />
          <h2 class="font-bold text-sm text-slate-900 dark:text-white">Table of Contents</h2>
          <span class="text-xs font-mono text-text-muted">({filteredHeadings.length} sections)</span>
        </div>
        <button
          id="pill-toc-close"
          type="button"
          class="p-1.5 rounded-xl text-slate-500 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
          aria-label="Close table of contents"
        >
          <X class="w-5 h-5" />
        </button>
      </div>

      <!-- Scrollable List of Sections -->
      <nav class="overflow-y-auto py-3 space-y-1 flex-1 text-xs" aria-label="Table of contents sections">
        {filteredHeadings.map(h => (
          <a
            href={`#${h.slug}`}
            class={`pill-toc-link block py-2 px-3 rounded-xl transition-colors ${
              h.depth === 3 
                ? 'pl-7 text-[11px] text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/80' 
                : 'font-semibold text-slate-800 dark:text-slate-200 hover:text-accent-primary dark:hover:text-accent-primaryDark hover:bg-slate-100 dark:hover:bg-slate-800'
            }`}
          >
            {h.text}
          </a>
        ))}
      </nav>

      <!-- Sheet Footer Info -->
      <div class="pt-3 border-t border-subtle text-[11px] font-mono text-text-muted flex items-center justify-between shrink-0">
        <span>Tap any heading to jump</span>
        <button id="pill-toc-close-bottom" type="button" class="text-accent-primary dark:text-accent-primaryDark hover:underline">
          Done
        </button>
      </div>
    </div>
  </div>
)}

<!-- Mobile Personal Notes Bottom Sheet Drawer -->
{slug && (
  <div
    id="pill-notes-sheet"
    class="fixed inset-0 z-50 pointer-events-none opacity-0 transition-opacity duration-200 ease-out md:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Personal Reading Notes"
    aria-hidden="true"
    data-slug={slug}
  >
    <!-- Dark Backdrop Overlay -->
    <div id="pill-notes-backdrop" class="absolute inset-0 bg-slate-950/70 backdrop-blur-sm"></div>

    <!-- Sheet Surface Container -->
    <div
      id="pill-notes-surface"
      class="absolute bottom-0 inset-x-0 max-h-[80vh] bg-[var(--surface-card)] rounded-t-3xl border-t border-subtle shadow-2xl p-5 pb-[calc(1.5rem+env(safe-area-inset-bottom,0px))] flex flex-col transform translate-y-full transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
    >
      <!-- Sheet Header -->
      <div class="flex items-center justify-between pb-3 border-b border-subtle shrink-0">
        <div class="flex items-center gap-2">
          <PenLine class="w-4 h-4 text-accent-primary dark:text-accent-primaryDark" />
          <h2 class="font-bold text-sm text-slate-900 dark:text-white">Reading Notes</h2>
          <span id="pill-notes-status" class="text-[10px] font-mono text-emerald-500">Saved</span>
        </div>
        
        <div class="flex items-center gap-1">
          <button
            id="pill-notes-copy"
            type="button"
            class="p-1.5 rounded-xl text-slate-500 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
            title="Copy notes"
            aria-label="Copy notes"
          >
            <Copy class="w-4 h-4" />
          </button>
          <button
            id="pill-notes-clear"
            type="button"
            class="p-1.5 rounded-xl text-slate-500 hover:text-rose-500 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
            title="Clear notes"
            aria-label="Clear notes"
          >
            <Trash2 class="w-4 h-4" />
          </button>
          <button
            id="pill-notes-close"
            type="button"
            class="p-1.5 rounded-xl text-slate-500 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors ml-1"
            aria-label="Close notes"
          >
            <X class="w-5 h-5" />
          </button>
        </div>
      </div>

      <!-- Notes Content Area -->
      <div class="py-3 flex-1 flex flex-col space-y-2">
        <textarea
          id="pill-notes-textarea"
          class="w-full flex-1 min-h-[140px] text-xs font-sans p-3 rounded-xl bg-slate-50 dark:bg-slate-900/90 border border-subtle focus:border-accent-primary outline-none resize-none text-slate-800 dark:text-slate-100 placeholder:text-slate-400 leading-relaxed"
          placeholder="Ghi chú cá nhân cho bài viết này... (Tự động lưu vào trình duyệt)"
        ></textarea>
      </div>

      <!-- Sheet Footer Info -->
      <div class="pt-3 border-t border-subtle text-[11px] font-mono text-text-muted flex items-center justify-between shrink-0">
        <span id="pill-notes-metrics">0 words &bull; 0 chars</span>
        <button id="pill-notes-close-bottom" type="button" class="text-accent-primary dark:text-accent-primaryDark hover:underline">
          Done
        </button>
      </div>
    </div>
  </div>
)}

<style>
  /* Touch target expansion for Apple HIG 44px compliance */
  @media (pointer: coarse) {
    .pill-action-btn {
      min-width: 36px;
      min-height: 36px;
      position: relative;
    }
    .pill-action-btn::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      min-width: 44px;
      min-height: 44px;
    }
  }

  /* Auto-hide states */
  .reading-pill-hidden {
    transform: translate(-50%, calc(100% + 2.5rem)) scale(0.95) !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }
</style>

<script>
  // Mark document body to suppress standalone back-to-top button overlap on mobile
  document.body.classList.add('has-reading-pill');

  const container = document.getElementById('reading-pill-container');
  const progressFill = document.getElementById('pill-progress-fill');
  const topBtn = document.getElementById('pill-top-btn');
  const shareBtn = document.getElementById('pill-share-btn');
  const tocBtn = document.getElementById('pill-toc-btn');
  const tocSheet = document.getElementById('pill-toc-sheet');
  const tocSurface = document.getElementById('pill-toc-surface');
  const tocBackdrop = document.getElementById('pill-toc-backdrop');
  const tocClose = document.getElementById('pill-toc-close');
  const tocCloseBottom = document.getElementById('pill-toc-close-bottom');
  const tocLinks = document.querySelectorAll('.pill-toc-link');

  // 1. Scroll-Aware Auto-Hide & Micro Progress Controller
  let lastScrollY = window.scrollY;
  let isTicking = false;
  let isSheetOpen = false;

  function handleScroll() {
    const currentScrollY = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;

    // Update micro progress bar
    if (progressFill && docHeight > 0) {
      const progress = Math.min(100, Math.max(0, (currentScrollY / docHeight) * 100));
      progressFill.style.width = `${progress}%`;
    }

    // Do not toggle visibility if TOC sheet is open
    if (!isSheetOpen && container) {
      const scrollDiff = currentScrollY - lastScrollY;
      const isNearBottom = docHeight > 0 && (docHeight - currentScrollY) < 140;

      if (isNearBottom || currentScrollY < 120) {
        // Always show near top or bottom
        container.classList.remove('reading-pill-hidden');
      } else if (scrollDiff > 8 && currentScrollY > 160) {
        // Scrolling down -> Auto-hide to maximize reading canvas
        container.classList.add('reading-pill-hidden');
      } else if (scrollDiff < -8) {
        // Scrolling up -> Reveal controls for thumb access
        container.classList.remove('reading-pill-hidden');
      }
    }

    lastScrollY = currentScrollY;
    isTicking = false;
  }

  window.addEventListener('scroll', () => {
    if (!isTicking) {
      window.requestAnimationFrame(handleScroll);
      isTicking = true;
    }
  }, { passive: true });

  // 2. Scroll to Top Action
  topBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // 3. Dual-Layer Resilient Share / Copy Link
  shareBtn?.addEventListener('click', async () => {
    const url = window.location.href;
    let success = false;

    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(url);
        success = true;
      } catch (e) {}
    }

    if (!success) {
      const ta = document.createElement('textarea');
      ta.value = url;
      ta.style.position = 'fixed';
      ta.style.left = '-999999px';
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      try {
        success = document.execCommand('copy');
      } catch (e) {}
      ta.remove();
    }

    if (success) {
      const defaultIcon = shareBtn.querySelector('.share-default-icon');
      const successIcon = shareBtn.querySelector('.share-success-icon');
      defaultIcon?.classList.add('hidden');
      successIcon?.classList.remove('hidden');

      setTimeout(() => {
        defaultIcon?.classList.remove('hidden');
        successIcon?.classList.add('hidden');
      }, 2000);
    }
  });

  // 6. Mobile TOC Bottom Sheet Drawer Logic
  function openTocSheet() {
    if (!tocSheet || !tocSurface) return;
    isSheetOpen = true;
    tocSheet.classList.remove('pointer-events-none', 'opacity-0');
    tocSheet.classList.add('pointer-events-auto', 'opacity-100');
    tocSheet.setAttribute('aria-hidden', 'false');
    tocBtn?.setAttribute('aria-expanded', 'true');
    tocSurface.classList.remove('translate-y-full');
    tocSurface.classList.add('translate-y-0');
    document.body.style.overflow = 'hidden';
  }

  function closeTocSheet() {
    if (!tocSheet || !tocSurface) return;
    isSheetOpen = false;
    tocSurface.classList.remove('translate-y-0');
    tocSurface.classList.add('translate-y-full');
    tocSheet.classList.remove('pointer-events-auto', 'opacity-100');
    tocSheet.classList.add('pointer-events-none', 'opacity-0');
    tocSheet.setAttribute('aria-hidden', 'true');
    tocBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  tocBtn?.addEventListener('click', openTocSheet);
  tocBackdrop?.addEventListener('click', closeTocSheet);
  tocClose?.addEventListener('click', closeTocSheet);
  tocCloseBottom?.addEventListener('click', closeTocSheet);

  tocLinks.forEach(link => {
    link.addEventListener('click', () => {
      closeTocSheet();
    });
  });

  // 7. Mobile Personal Notes Bottom Sheet Drawer Logic
  const notesBtn = document.getElementById('pill-notes-btn');
  const notesSheet = document.getElementById('pill-notes-sheet');
  const notesSurface = document.getElementById('pill-notes-surface');
  const notesBackdrop = document.getElementById('pill-notes-backdrop');
  const notesClose = document.getElementById('pill-notes-close');
  const notesCloseBottom = document.getElementById('pill-notes-close-bottom');
  const notesTextarea = document.getElementById('pill-notes-textarea') as HTMLTextAreaElement | null;
  const notesStatus = document.getElementById('pill-notes-status');
  const notesMetrics = document.getElementById('pill-notes-metrics');
  const notesCopy = document.getElementById('pill-notes-copy');
  const notesClear = document.getElementById('pill-notes-clear');

  const notesSlug = notesSheet?.getAttribute('data-slug') || '';
  const notesStorageKey = notesSlug ? `blog_notes_${notesSlug}` : '';

  let isNotesOpen = false;
  let notesSaveTimeout: number | undefined;

  function updatePillNotesMetrics(text: string) {
    const chars = text.length;
    const words = text.trim().length > 0 ? text.trim().split(/\s+/).length : 0;
    if (notesMetrics) {
      notesMetrics.textContent = `${words} words • ${chars} chars`;
    }
  }

  function openNotesSheet() {
    if (!notesSheet || !notesSurface) return;
    isNotesOpen = true;
    
    // Load latest value from storage
    if (notesTextarea && notesStorageKey) {
      const val = localStorage.getItem(notesStorageKey) || '';
      notesTextarea.value = val;
      updatePillNotesMetrics(val);
    }

    notesSheet.classList.remove('pointer-events-none', 'opacity-0');
    notesSheet.classList.add('pointer-events-auto', 'opacity-100');
    notesSheet.setAttribute('aria-hidden', 'false');
    notesBtn?.setAttribute('aria-expanded', 'true');
    notesSurface.classList.remove('translate-y-full');
    notesSurface.classList.add('translate-y-0');
    document.body.style.overflow = 'hidden';
  }

  function closeNotesSheet() {
    if (!notesSheet || !notesSurface) return;
    isNotesOpen = false;
    notesSurface.classList.remove('translate-y-0');
    notesSurface.classList.add('translate-y-full');
    notesSheet.classList.remove('pointer-events-auto', 'opacity-100');
    notesSheet.classList.add('pointer-events-none', 'opacity-0');
    notesSheet.setAttribute('aria-hidden', 'true');
    notesBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  notesBtn?.addEventListener('click', openNotesSheet);
  notesBackdrop?.addEventListener('click', closeNotesSheet);
  notesClose?.addEventListener('click', closeNotesSheet);
  notesCloseBottom?.addEventListener('click', closeNotesSheet);

  notesTextarea?.addEventListener('input', () => {
    if (!notesStatus || !notesStorageKey) return;
    notesStatus.textContent = 'Saving...';
    notesStatus.className = 'text-[10px] font-mono text-amber-500';

    window.clearTimeout(notesSaveTimeout);
    notesSaveTimeout = window.setTimeout(() => {
      const val = notesTextarea.value;
      localStorage.setItem(notesStorageKey, val);
      updatePillNotesMetrics(val);
      notesStatus.textContent = 'Saved';
      notesStatus.className = 'text-[10px] font-mono text-emerald-500';
    }, 300);
  });

  notesCopy?.addEventListener('click', async () => {
    const val = notesTextarea?.value || '';
    if (!val) return;
    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(val);
      } catch {}
    }
  });

  notesClear?.addEventListener('click', () => {
    if (!notesTextarea || !notesStorageKey) return;
    if (window.confirm('Clear your notes for this article?')) {
      notesTextarea.value = '';
      localStorage.removeItem(notesStorageKey);
      updatePillNotesMetrics('');
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (isSheetOpen) closeTocSheet();
      if (isNotesOpen) closeNotesSheet();
    }
  });
</script>
