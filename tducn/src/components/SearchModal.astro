---
// ponytail: Senior Smart Search Engine Modal with Vietnamese NLP, Keyboard Navigation, and Category Filtering
import { NAV_ITEMS } from '../utils/categories';
import { Search, X } from 'lucide-astro';
---

<div id="search-modal" class="hidden fixed inset-0 z-50 flex items-start justify-center pt-16 sm:pt-20 bg-black/60 backdrop-blur-sm p-4 transition-opacity">
  <div class="card-surface rounded-2xl max-w-2xl w-full p-4 sm:p-5 space-y-4 shadow-2xl overflow-hidden" id="search-dialog" role="dialog" aria-modal="true" aria-label="Tìm kiếm bài viết">
    
    <!-- Top Search Input Bar -->
    <div class="flex items-center space-x-3 border-b border-subtle pb-3">
      <Search class="w-5 h-5 text-slate-400 shrink-0" />
      <input
        type="text"
        id="search-input"
        placeholder="Tìm bài viết, thuật toán, công thức (gõ không dấu hoặc có dấu)..."
        class="w-full bg-transparent text-sm sm:text-base focus:outline-none text-slate-900 dark:text-white placeholder:text-slate-400"
        autocomplete="off"
        spellcheck="false"
        aria-label="Ô tìm kiếm bài viết"
      />
      <div class="flex items-center space-x-1.5 shrink-0">
        <button id="search-clear-btn" class="hidden text-xs w-6 h-6 rounded-full hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-400 flex items-center justify-center font-bold" title="Xóa nội dung" aria-label="Xóa nội dung">&times;</button>
        <button id="search-close-btn" class="text-[11px] px-2 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-500 font-mono hover:bg-slate-200 dark:hover:bg-slate-700" aria-label="Đóng tìm kiếm">ESC</button>
      </div>
    </div>

    <!-- Category Filter Chips -->
    <div class="flex items-center space-x-1.5 overflow-x-auto pb-1 text-xs" id="search-category-filters">
      {NAV_ITEMS.map(cat => (
        <button
          type="button"
          data-category-filter={cat.slug}
          class={`px-2.5 py-1 rounded-full font-medium transition-all text-xs ${
            cat.slug === 'all'
              ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-semibold shadow-sm'
              : 'border border-subtle text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800'
          }`}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- Results Area -->
    <div id="search-results-list" class="space-y-1.5 max-h-[55vh] overflow-y-auto text-xs pr-1">
      <!-- Populated dynamically -->
    </div>

    <!-- Modal Keyboard Shortcut Footer -->
    <div class="border-t border-subtle pt-3 flex items-center justify-between text-[11px] text-text-muted font-mono">
      <div class="flex items-center space-x-3">
        <span class="flex items-center gap-1"><kbd class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 border border-subtle">↑</kbd><kbd class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 border border-subtle">↓</kbd> Di chuyển</span>
        <span class="flex items-center gap-1"><kbd class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 border border-subtle">↵</kbd> Chọn</span>
        <span class="flex items-center gap-1"><kbd class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 border border-subtle">esc</kbd> Thoát</span>
      </div>
      <div id="search-count-badge" class="font-medium text-slate-500">
        4 bài viết sẵn sàng
      </div>
    </div>

  </div>
</div>

<script>
  import { searchEngine, type SearchItem, type ScoredSearchResult } from '../utils/searchEngine';

  const searchModal = document.getElementById('search-modal');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const searchClose = document.getElementById('search-close-btn');
  const searchClear = document.getElementById('search-clear-btn');
  const resultsContainer = document.getElementById('search-results-list');
  const categoryFilters = document.getElementById('search-category-filters');
  const countBadge = document.getElementById('search-count-badge');

  let postsData: SearchItem[] = [];
  let isFetching = false;
  let activeFilterSlug = 'all';
  let activeItemIndex = -1;
  let currentResults: ScoredSearchResult[] = [];

  // Open / Close modal
  function toggleSearch(show: boolean) {
    if (!searchModal) return;
    if (show) {
      searchModal.classList.remove('hidden');
      setTimeout(() => searchInput?.focus(), 50);
      loadSearchData();
    } else {
      searchModal.classList.add('hidden');
      if (searchInput) searchInput.value = '';
      if (searchClear) searchClear.classList.add('hidden');
      activeItemIndex = -1;
      renderDefaultState();
    }
  }

  // Load search index JSON once
  async function loadSearchData() {
    if (postsData.length > 0 || isFetching) return;
    isFetching = true;
    try {
      const res = await fetch('/search.json');
      postsData = await res.json();
      if (countBadge) countBadge.textContent = `${postsData.length} bài viết sẵn sàng`;
      if (!searchInput?.value.trim()) renderDefaultState();
    } catch (e) {
      console.warn('Could not load search index', e);
    } finally {
      isFetching = false;
    }
  }

  // Render initial suggestions when input is empty
  function renderDefaultState() {
    if (!resultsContainer) return;
    const popularTags = ['Cache Invalidation', 'Zipf', 'Biến đổi Fourier', 'Content Collections', 'Tĩnh lặng'];

    resultsContainer.innerHTML = `
      <div class="p-4 space-y-4">
        <div>
          <div class="text-[11px] font-bold text-text-muted uppercase tracking-wider mb-2">Gợi ý tìm kiếm phổ biến</div>
          <div class="flex flex-wrap gap-1.5">
            ${popularTags.map(tag => `
              <button type="button" class="quick-tag px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:text-accent-primary dark:hover:text-accent-primaryDark hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                ${tag}
              </button>
            `).join('')}
          </div>
        </div>

        <div>
          <div class="text-[11px] font-bold text-text-muted uppercase tracking-wider mb-2">Toàn bộ tuyển tập gần đây</div>
          <div class="space-y-1">
            ${postsData.slice(0, 3).map(p => `
              <a href="/posts/${p.slug}" class="block p-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors group">
                <div class="flex items-center justify-between text-[11px]">
                  <span class="font-medium text-slate-900 dark:text-slate-100 group-hover:text-accent-primary dark:group-hover:text-accent-primaryDark">${p.title}</span>
                  <span class="font-mono text-text-muted uppercase">${p.category}</span>
                </div>
              </a>
            `).join('')}
          </div>
        </div>
      </div>
    `;

    // Bind click to quick suggestions
    resultsContainer.querySelectorAll('.quick-tag').forEach(btn => {
      btn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = btn.textContent?.trim() || '';
          triggerSearch();
        }
      });
    });

    if (countBadge) countBadge.textContent = `${postsData.length} bài viết sẵn sàng`;
    activeItemIndex = -1;
  }

  // Execute search and render results
  function triggerSearch() {
    const query = searchInput?.value.trim() || '';
    if (searchClear) {
      if (query) searchClear.classList.remove('hidden');
      else searchClear.classList.add('hidden');
    }

    if (!query && activeFilterSlug === 'all') {
      renderDefaultState();
      return;
    }

    currentResults = searchEngine(postsData, query, activeFilterSlug);
    activeItemIndex = currentResults.length > 0 ? 0 : -1;
    renderResults(currentResults, query);
  }

  function renderResults(results: ScoredSearchResult[], query: string) {
    if (!resultsContainer) return;

    if (results.length === 0) {
      resultsContainer.innerHTML = `
        <div class="p-8 text-center space-y-2">
          <div class="text-2xl">🔍</div>
          <div class="font-semibold text-slate-900 dark:text-white">Không tìm thấy bài viết phù hợp</div>
          <div class="text-xs text-text-muted max-w-sm mx-auto">
            Không có kết quả nào cho "${query}". Hãy thử gõ không dấu hoặc chọn chuyên mục khác.
          </div>
        </div>
      `;
      if (countBadge) countBadge.textContent = '0 kết quả';
      return;
    }

    if (countBadge) countBadge.textContent = `${results.length} bài viết phù hợp`;

    resultsContainer.innerHTML = results.map((res, index) => {
      const isSelected = index === activeItemIndex;
      return `
        <a
          href="/posts/${res.item.slug}"
          data-index="${index}"
          class="search-result-item block p-3 rounded-xl transition-all border ${
            isSelected
              ? 'bg-slate-100 dark:bg-slate-800/90 border-slate-300 dark:border-slate-700 shadow-sm'
              : 'border-transparent hover:bg-slate-100 dark:hover:bg-slate-800/60'
          } group"
        >
          <div class="flex items-center justify-between text-[11px] mb-1">
            <span class="font-mono uppercase font-semibold text-accent-primary dark:text-accent-primaryDark">${res.item.category}</span>
            ${res.score >= 100 ? '<span class="text-[10px] px-1.5 py-0.2 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400 font-mono">Khớp cao</span>' : ''}
          </div>
          <div class="font-medium text-slate-900 dark:text-slate-100 group-hover:text-accent-primary dark:group-hover:text-accent-primaryDark transition-colors leading-snug">
            ${res.highlightedTitle}
          </div>
          <div class="text-[11px] text-text-muted line-clamp-1 mt-0.5">
            ${res.highlightedDescription}
          </div>
          ${res.highlightedSnippet ? `
            <div class="text-[11px] text-slate-500 font-mono line-clamp-1 mt-1 pl-2 border-l-2 border-slate-300 dark:border-slate-700">
              ...${res.highlightedSnippet}
            </div>
          ` : ''}
        </a>
      `;
    }).join('');
  }

  // Update active item visual indicator
  function updateActiveVisual() {
    const items = resultsContainer?.querySelectorAll('.search-result-item');
    items?.forEach((el, idx) => {
      if (idx === activeItemIndex) {
        el.className = 'search-result-item block p-3 rounded-xl transition-all border bg-slate-100 dark:bg-slate-800/90 border-slate-300 dark:border-slate-700 shadow-sm group';
        (el as HTMLElement).scrollIntoView({ block: 'nearest' });
      } else {
        el.className = 'search-result-item block p-3 rounded-xl transition-all border border-transparent hover:bg-slate-100 dark:hover:bg-slate-800/60 group';
      }
    });
  }

  // Keyboard navigation inside input
  searchInput?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (currentResults.length > 0) {
        activeItemIndex = (activeItemIndex + 1) % currentResults.length;
        updateActiveVisual();
      }
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (currentResults.length > 0) {
        activeItemIndex = (activeItemIndex - 1 + currentResults.length) % currentResults.length;
        updateActiveVisual();
      }
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (activeItemIndex >= 0 && activeItemIndex < currentResults.length) {
        window.location.href = `/posts/${currentResults[activeItemIndex].item.slug}`;
      }
    }
  });

  // Debounced input listener
  let debounceTimeout: any = null;
  searchInput?.addEventListener('input', () => {
    clearTimeout(debounceTimeout);
    debounceTimeout = setTimeout(triggerSearch, 80);
  });

  // Clear button click
  searchClear?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
      triggerSearch();
    }
  });

  // Category filter chips click
  categoryFilters?.querySelectorAll('button[data-category-filter]').forEach(btn => {
    btn.addEventListener('click', () => {
      const slug = btn.getAttribute('data-category-filter') || 'all';
      activeFilterSlug = slug;

      // Update button styling
      categoryFilters.querySelectorAll('button[data-category-filter]').forEach(b => {
        b.className = 'px-2.5 py-1 rounded-full font-medium transition-all text-xs border border-subtle text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800';
      });
      btn.className = 'px-2.5 py-1 rounded-full font-semibold transition-all text-xs bg-slate-900 text-white dark:bg-white dark:text-slate-900 shadow-sm';

      triggerSearch();
    });
  });

  // Global shortcuts: Cmd+K, Ctrl+K, /, Escape
  document.addEventListener('keydown', (e) => {
    const isEditing = ['INPUT', 'TEXTAREA'].includes((document.activeElement as HTMLElement)?.tagName);
    
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      toggleSearch(true);
    } else if (e.key === '/' && !isEditing) {
      e.preventDefault();
      toggleSearch(true);
    } else if (e.key === 'Escape') {
      toggleSearch(false);
    }
  });

  searchClose?.addEventListener('click', () => toggleSearch(false));
  searchModal?.addEventListener('click', (e) => {
    if (e.target === searchModal) toggleSearch(false);
  });

  // Global export
  (window as any).openSearchModal = () => toggleSearch(true);
</script>
