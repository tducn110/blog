---
// ponytail: Accessible, premium Reader's Scratchpad with keyboard auto-trigger, auto-save, and clean toolbar
import { PenLine, Copy, Download, Trash2, ChevronDown, Check } from 'lucide-astro';

interface Props {
  slug: string;
  title?: string;
}

const { slug, title = '' } = Astro.props;
---

<div
  id="reader-notes-card"
  class="card-surface shadow-sm hover:shadow-md border border-subtle rounded-2xl transition-all duration-200 select-none"
  data-slug={slug}
  data-title={title}
  aria-label="Personal Reading Notes"
>
  <!-- Clean, Serene Header (Symmetrically aligned with Table of Contents) -->
  <div
    id="notes-header"
    class="flex items-center justify-between p-4 cursor-pointer hover:bg-slate-50/60 dark:hover:bg-slate-800/40 rounded-2xl transition-colors"
    role="button"
    tabindex="0"
    aria-expanded="true"
    aria-controls="notes-body"
  >
    <div class="flex items-center gap-2 text-xs font-bold text-text-main">
      <PenLine class="w-3.5 h-3.5 text-accent-primary dark:text-accent-primaryDark shrink-0" />
      <span>Reading Notes</span>
      <span
        id="notes-count-badge"
        class="text-[10px] font-mono text-text-muted bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded-full border border-subtle hidden"
      >
        0
      </span>
    </div>

    <!-- Toggle Button (Consistent with TOC button design) -->
    <button
      id="notes-toggle-btn"
      type="button"
      class="text-[11px] font-mono text-text-muted hover:text-text-main bg-slate-100/80 dark:bg-slate-800/80 px-2 py-0.5 rounded-lg flex items-center gap-1 transition-all cursor-pointer border border-subtle"
      aria-expanded="true"
      aria-controls="notes-body"
      title="Toggle Notes Panel"
    >
      <span id="notes-toggle-label">Collapse</span>
      <ChevronDown id="notes-toggle-icon" class="w-3.5 h-3.5 transition-transform duration-200" />
    </button>
  </div>

  <!-- Collapsible Notes Body -->
  <div id="notes-body" class="px-4 pb-4 pt-1 border-t border-subtle/80 space-y-3 transition-all duration-300">
    <!-- Note Editor Area -->
    <div class="relative">
      <textarea
        id="reader-notes-textarea"
        class="w-full h-32 text-xs font-sans p-3 rounded-xl bg-slate-50/80 dark:bg-slate-900/80 border border-subtle focus:border-accent-primary dark:focus:border-accent-primaryDark focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-accent-primary/15 dark:focus:ring-accent-primaryDark/20 outline-none resize-y transition-all text-slate-800 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-500 leading-relaxed custom-scrollbar"
        placeholder="Ghi chú cá nhân, công thức cần nhớ... (Gõ phím khi đọc bài để tự động ghi chú)"
        aria-label="Personal notes text area"
      ></textarea>
    </div>

    <!-- Clean Footer Toolbar with Status & Actions -->
    <div class="flex items-center justify-between text-[11px] pt-1.5 border-t border-subtle/60 text-text-muted gap-2">
      <!-- Left: Metrics & Auto-save Status -->
      <div class="flex items-center gap-1.5 font-mono text-[10px] shrink-0">
        <span id="notes-metrics">0 words</span>
        <span class="text-slate-300 dark:text-slate-600">&bull;</span>
        <span id="notes-save-status" class="inline-flex items-center gap-1 text-emerald-600 dark:text-emerald-400">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span id="notes-status-text">Saved</span>
        </span>
      </div>

      <!-- Right: Action Buttons -->
      <div class="flex items-center gap-1 shrink-0">
        <button
          id="notes-copy-btn"
          type="button"
          class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md text-[10px] font-mono text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white bg-slate-100/70 dark:bg-slate-800/70 hover:bg-slate-200/80 dark:hover:bg-slate-700/80 border border-subtle transition-all cursor-pointer"
          title="Copy notes to clipboard"
          aria-label="Copy notes"
        >
          <Copy class="w-2.5 h-2.5 notes-copy-default" />
          <Check class="w-2.5 h-2.5 text-emerald-500 notes-copy-success hidden" />
          <span>Copy</span>
        </button>

        <button
          id="notes-download-btn"
          type="button"
          class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md text-[10px] font-mono text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white bg-slate-100/70 dark:bg-slate-800/70 hover:bg-slate-200/80 dark:hover:bg-slate-700/80 border border-subtle transition-all cursor-pointer"
          title="Download notes (.txt)"
          aria-label="Export notes"
        >
          <Download class="w-2.5 h-2.5" />
          <span>Export</span>
        </button>

        <button
          id="notes-clear-btn"
          type="button"
          class="p-1 rounded-md text-slate-400 hover:text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/40 border border-subtle transition-all cursor-pointer"
          title="Clear notes"
          aria-label="Clear notes"
        >
          <Trash2 class="w-2.5 h-2.5" />
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  /* Collapsed state */
  #reader-notes-card.notes-is-collapsed #notes-body {
    display: none;
  }

  #reader-notes-card.notes-is-collapsed #notes-toggle-icon {
    transform: rotate(-90deg);
  }

  /* Smooth scrollbar in textarea */
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(150, 150, 150, 0.2);
    border-radius: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(150, 150, 150, 0.4);
  }
</style>

<script>
  const notesCard = document.getElementById('reader-notes-card');
  const notesHeader = document.getElementById('notes-header');
  const slug = notesCard?.getAttribute('data-slug') || 'default';
  const postTitle = notesCard?.getAttribute('data-title') || 'Article Notes';
  const storageKey = `blog_notes_${slug}`;

  const textarea = document.getElementById('reader-notes-textarea') as HTMLTextAreaElement | null;
  const toggleBtn = document.getElementById('notes-toggle-btn');
  const toggleLabel = document.getElementById('notes-toggle-label');
  const copyBtn = document.getElementById('notes-copy-btn');
  const downloadBtn = document.getElementById('notes-download-btn');
  const clearBtn = document.getElementById('notes-clear-btn');
  const statusSpan = document.getElementById('notes-save-status');
  const statusText = document.getElementById('notes-status-text');
  const metricsSpan = document.getElementById('notes-char-count') || document.getElementById('notes-metrics');
  const countBadge = document.getElementById('notes-count-badge');

  let isTextareaFocused = false;
  let saveTimeout: number | undefined;

  // Helper to collapse Table of Contents when Notes is active
  function collapseTableOfContents() {
    const tocNav = document.getElementById('article-toc');
    const tocToggleLabel = document.getElementById('toc-toggle-label');
    const tocToggleBtn = document.getElementById('toc-toggle-btn');
    const tocHeader = document.getElementById('toc-header');
    if (tocNav) {
      tocNav.classList.add('toc-is-collapsed');
      if (tocToggleLabel) tocToggleLabel.textContent = 'Expand';
      if (tocToggleBtn) tocToggleBtn.setAttribute('aria-expanded', 'false');
      if (tocHeader) tocHeader.setAttribute('aria-expanded', 'false');
    }
  }

  // 1. Load initial notes
  const savedNotes = localStorage.getItem(storageKey) || '';
  if (textarea) {
    textarea.value = savedNotes;
  }

  function updateMetrics(text: string) {
    const chars = text.length;
    const words = text.trim().length > 0 ? text.trim().split(/\s+/).length : 0;

    if (metricsSpan) {
      metricsSpan.textContent = `${words} ${words === 1 ? 'word' : 'words'}`;
    }

    if (countBadge) {
      if (chars > 0) {
        countBadge.textContent = `${words}`;
        countBadge.classList.remove('hidden');
      } else {
        countBadge.classList.add('hidden');
      }
    }
  }

  updateMetrics(savedNotes);

  // 2. Debounced Auto-Save
  textarea?.addEventListener('input', () => {
    if (!statusSpan || !statusText) return;

    statusSpan.classList.remove('hidden');
    statusText.textContent = 'Saving...';
    statusSpan.classList.remove('text-emerald-500');
    statusSpan.classList.add('text-amber-500');

    window.clearTimeout(saveTimeout);
    saveTimeout = window.setTimeout(() => {
      const val = textarea?.value || '';
      localStorage.setItem(storageKey, val);
      updateMetrics(val);

      statusText.textContent = 'Saved';
      statusSpan.classList.remove('text-amber-500');
      statusSpan.classList.add('text-emerald-500');
    }, 300);
  });

  textarea?.addEventListener('focus', () => {
    isTextareaFocused = true;
    collapseTableOfContents();
  });

  textarea?.addEventListener('blur', () => {
    isTextareaFocused = false;
  });

  // 3. Manual Collapse / Expand
  let isCollapsed = localStorage.getItem('blog_notes_collapsed') === 'true';

  function setNotesCollapsed(collapsed: boolean) {
    isCollapsed = collapsed;
    if (!notesCard || !toggleBtn || !toggleLabel || !notesHeader) return;

    if (isCollapsed) {
      notesCard.classList.add('notes-is-collapsed');
      toggleLabel.textContent = 'Expand';
      toggleBtn.setAttribute('aria-expanded', 'false');
      notesHeader.setAttribute('aria-expanded', 'false');
    } else {
      notesCard.classList.remove('notes-is-collapsed');
      toggleLabel.textContent = 'Collapse';
      toggleBtn.setAttribute('aria-expanded', 'true');
      notesHeader.setAttribute('aria-expanded', 'true');
    }
    localStorage.setItem('blog_notes_collapsed', String(isCollapsed));
  }

  if (isCollapsed) {
    setNotesCollapsed(true);
  }

  // Toggle on clicking header or button
  function toggleNotes() {
    setNotesCollapsed(!isCollapsed);
    if (!isCollapsed) {
      collapseTableOfContents();
    }
  }

  notesHeader?.addEventListener('click', (e) => {
    if (e.target !== toggleBtn && !toggleBtn?.contains(e.target as Node)) {
      toggleNotes();
    }
  });

  notesHeader?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      toggleNotes();
    }
  });

  toggleBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleNotes();
  });

  // 4. Keyboard Quick-Trigger: Typing while reading automatically opens notes and captures text
  window.addEventListener('keydown', (e: KeyboardEvent) => {
    // 1. If active element is already an input, textarea, select, or editable element, let it handle
    const active = document.activeElement;
    if (active && (
      active.tagName === 'INPUT' ||
      active.tagName === 'TEXTAREA' ||
      active.tagName === 'SELECT' ||
      (active as HTMLElement).isContentEditable
    )) {
      return;
    }

    // 2. Ignore modifier shortcuts (Ctrl, Meta/Command, Alt) like Cmd+K, Ctrl+C, Alt+Tab
    if (e.ctrlKey || e.metaKey || e.altKey) {
      return;
    }

    // 3. Ignore control, navigation, and function keys
    if (
      e.key === 'Escape' ||
      e.key === 'Tab' ||
      e.key === 'Enter' ||
      e.key === 'Backspace' ||
      e.key === 'Delete' ||
      e.key.startsWith('Arrow') ||
      e.key.startsWith('F') ||
      e.key === 'CapsLock' ||
      e.key === 'Shift' ||
      e.key === 'Control' ||
      e.key === 'Alt' ||
      e.key === 'Meta' ||
      e.key === 'PageUp' ||
      e.key === 'PageDown' ||
      e.key === 'Home' ||
      e.key === 'End'
    ) {
      return;
    }

    // 4. Printable character pressed by user while reading
    if (e.key.length === 1) {
      // Collapse Table of Contents
      collapseTableOfContents();

      // Desktop flow
      if (textarea && notesCard) {
        setNotesCollapsed(false);

        // Append typed character at cursor position or end
        const start = textarea.selectionStart ?? textarea.value.length;
        const end = textarea.selectionEnd ?? textarea.value.length;
        const val = textarea.value;

        e.preventDefault();
        textarea.value = val.substring(0, start) + e.key + val.substring(end);
        textarea.selectionStart = textarea.selectionEnd = start + e.key.length;
        textarea.focus();

        // Dispatch input event for auto-save and metrics
        textarea.dispatchEvent(new Event('input', { bubbles: true }));
      } else {
        // Mobile fallback: open mobile bottom sheet drawer if available
        const mobileNotesBtn = document.getElementById('reading-pill-notes-btn');
        if (mobileNotesBtn) {
          mobileNotesBtn.click();
          const mobileTextarea = document.getElementById('mobile-notes-textarea') as HTMLTextAreaElement | null;
          if (mobileTextarea) {
            e.preventDefault();
            mobileTextarea.value += e.key;
            mobileTextarea.focus();
            mobileTextarea.dispatchEvent(new Event('input', { bubbles: true }));
          }
        }
      }
    }
  });

  // 5. Copy Notes to Clipboard
  copyBtn?.addEventListener('click', async () => {
    const val = textarea?.value || '';
    if (!val) return;

    let copied = false;
    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(val);
        copied = true;
      } catch {}
    }

    if (!copied) {
      const ta = document.createElement('textarea');
      ta.value = val;
      ta.style.position = 'fixed';
      ta.style.left = '-999999px';
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      try {
        copied = document.execCommand('copy');
      } catch {}
      ta.remove();
    }

    if (copied) {
      const defaultIcon = copyBtn.querySelector('.notes-copy-default');
      const successIcon = copyBtn.querySelector('.notes-copy-success');
      defaultIcon?.classList.add('hidden');
      successIcon?.classList.remove('hidden');

      setTimeout(() => {
        defaultIcon?.classList.remove('hidden');
        successIcon?.classList.add('hidden');
      }, 2000);
    }
  });

  // 6. Download Notes (.txt)
  downloadBtn?.addEventListener('click', () => {
    const val = textarea?.value || '';
    if (!val.trim()) return;

    const fileContent = `=== NOTES: ${postTitle} ===\nExported: ${new Date().toLocaleString()}\n\n${val}\n`;
    const blob = new Blob([fileContent], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${slug}-notes.txt`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  });

  // 7. Clear Notes
  clearBtn?.addEventListener('click', () => {
    const val = textarea?.value || '';
    if (!val.trim()) return;

    if (window.confirm('Are you sure you want to clear your notes for this article?')) {
      if (textarea) textarea.value = '';
      localStorage.removeItem(storageKey);
      updateMetrics('');
      if (statusSpan && statusText) {
        statusText.textContent = 'Cleared';
        setTimeout(() => {
          statusSpan.classList.add('hidden');
        }, 1500);
      }
    }
  });
</script>
