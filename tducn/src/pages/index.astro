---
// ponytail: Clean index page with 12-column grid and unified PostCard components
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import CategoryPills from '../components/CategoryPills.astro';
import { CATEGORIES } from '../utils/categories';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const featuredPost = sortedPosts.find(p => p.data.featured) || sortedPosts[0];
const recentPosts = sortedPosts.filter(p => p.slug !== featuredPost?.slug);
---

<BaseLayout title="Trang chủ & Bài viết">
  <div class="space-y-8">
    
    <!-- Hero Statement Banner (4*x Spacing: p-8 = 32px) -->
    <section class="card-surface p-6 sm:p-8 rounded-3xl space-y-3 shadow-sm relative overflow-hidden">
      <div class="absolute -top-16 -right-16 w-56 h-56 rounded-full bg-accent-primary/5 dark:bg-accent-primaryDark/10 blur-3xl pointer-events-none"></div>

      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800/80 border border-subtle text-xs text-text-muted font-medium">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Ghi chép & Khảo cứu độc lập</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white leading-snug">
        Kiến trúc Hệ thống, Toán học Ứng dụng & Suy tưởng
      </h1>
      <p class="text-sm text-text-muted max-w-2xl leading-relaxed">
        Không gian độc lập để chia sẻ những gì tôi quan tâm: từ bài toán tối ưu độ trễ biên mạng, thuật toán xử lý tín hiệu cho tới những bài tản văn chiêm nghiệm cuộc sống.
      </p>
    </section>

    <!-- 12-Column Responsive Grid: 8 cols Feed + 4 cols Sidebar -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-10">
      
      <!-- Main Feed Column (8 cols = 66.6%) -->
      <div class="md:col-span-8 space-y-6">
        
        <!-- Reusable Category Filter Pills -->
        <CategoryPills activeSlug="all" />

        <!-- Featured Post Hero Card (Refactored to PostCard) -->
        {featuredPost && (
          <PostCard
            title={featuredPost.data.title}
            description={featuredPost.data.description}
            slug={featuredPost.slug}
            category={featuredPost.data.category}
            publishDate={featuredPost.data.publishDate}
            tags={featuredPost.data.tags}
            featured={true}
          />
        )}

        <!-- Recent Posts List (Refactored to PostCard) -->
        <div class="space-y-4">
          <div class="text-xs font-bold uppercase tracking-wider text-text-muted pt-2">
            Bài viết gần đây
          </div>

          {recentPosts.map(post => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              slug={post.slug}
              category={post.data.category}
              publishDate={post.data.publishDate}
              tags={post.data.tags}
            />
          ))}
        </div>

      </div>

      <!-- Right Sidebar Column (4 cols = 33.3%) -->
      <aside class="md:col-span-4 space-y-6">
        
        <!-- Author Profile Card (Refactored to .card-surface) -->
        <div class="card-surface p-6 sm:p-7 space-y-3 shadow-sm text-xs">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-full bg-accent-primary flex items-center justify-center text-white font-bold text-sm shadow">
              CN
            </div>
            <div>
              <div class="font-bold text-sm text-slate-900 dark:text-white">Chi Nguyen</div>
              <div class="text-text-muted font-mono text-[11px]">Systems & Applied Math</div>
            </div>
          </div>
          <p class="text-text-muted leading-relaxed">
            Viết về kiến trúc phân tán, biến đổi tín hiệu rời rạc và những bài học rút ra trong quá trình thiết kế hệ thống thực chiến.
          </p>
        </div>

        <!-- Category Directory Card (Refactored to .card-surface) -->
        <div class="card-surface p-6 sm:p-7 space-y-3 shadow-sm text-xs">
          <div class="font-bold text-slate-900 dark:text-white text-sm border-b border-subtle pb-2">
            Chuyên mục khảo cứu
          </div>
          <div class="space-y-2">
            {Object.entries(CATEGORIES).map(([key, info]) => {
              const count = allPosts.filter(p => p.data.category === key).length;
              return (
                <a
                  href={`/category/${key}`}
                  class="flex items-center justify-between p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors group"
                >
                  <span class="text-slate-700 dark:text-slate-300 group-hover:text-slate-900 dark:group-hover:text-white font-medium">
                    {info.label}
                  </span>
                  <span class="font-mono text-[11px] text-text-muted bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded-full">
                    {count}
                  </span>
                </a>
              );
            })}
          </div>
        </div>

      </aside>

    </div>

  </div>
</BaseLayout>
