---
// ponytail: Highly reusable Post Card component with flexible layouts (featured / default / compact) and tags support
import CategoryBadge from './CategoryBadge.astro';
import type { CategoryKey } from '../utils/categories';

interface Props {
  title: string;
  description: string;
  slug: string;
  category: CategoryKey;
  publishDate: Date;
  readingTime?: string;
  tags?: string[];
  featured?: boolean;
  compact?: boolean;
  showCategory?: boolean;
  class?: string;
}

const {
  title,
  description,
  slug,
  category,
  publishDate,
  readingTime,
  tags = [],
  featured = false,
  compact = false,
  showCategory = true,
  class: className = '',
} = Astro.props;
---

<article class={`card-surface group transition-all duration-200 shadow-sm hover:shadow-md hover:-translate-y-0.5 ${
  featured 
    ? 'p-5 sm:p-8 space-y-3.5 sm:space-y-4 hover:border-accent-primary dark:hover:border-accent-primaryDark rounded-2xl sm:rounded-3xl' 
    : compact
      ? 'p-4 sm:p-5 space-y-2 hover:border-slate-400 dark:hover:border-slate-600 rounded-xl'
      : 'p-5 sm:p-7 space-y-3 hover:border-slate-400 dark:hover:border-slate-600 rounded-2xl'
} ${className}`}>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between text-xs text-text-muted gap-2">
    <div class="flex items-center space-x-2 shrink-0">
      {showCategory && <CategoryBadge category={category} />}
      {featured && (
        <span class="font-semibold text-accent-primary dark:text-accent-primaryDark px-2 py-0.5 rounded-full bg-accent-primary/10 text-[11px] whitespace-nowrap">
          Featured
        </span>
      )}
    </div>
    <div class="flex items-center space-x-1.5 font-mono text-[11px] text-text-muted shrink-0 whitespace-nowrap">
      <time datetime={publishDate.toISOString()} class="whitespace-nowrap">
        {publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
      </time>
      {readingTime && (
        <span class="whitespace-nowrap">&bull; {readingTime}</span>
      )}
    </div>
  </div>

  <h2 class={`font-bold text-slate-900 dark:text-white group-hover:text-accent-primary dark:group-hover:text-accent-primaryDark transition-colors leading-snug ${
    featured 
      ? 'text-xl sm:text-2xl' 
      : compact 
        ? 'text-base sm:text-lg'
        : 'text-lg sm:text-xl'
  }`}>
    <a href={`/posts/${slug}`} class="block focus:outline-none focus-visible:underline">
      {title}
    </a>
  </h2>

  <p class={`text-text-muted leading-relaxed ${
    featured 
      ? 'text-sm line-clamp-3' 
      : compact
        ? 'text-xs line-clamp-1'
        : 'text-xs sm:text-sm line-clamp-2'
  }`}>
    {description}
  </p>

  {tags && tags.length > 0 && !compact && (
    <div class="flex flex-wrap gap-1.5 pt-1">
      {tags.slice(0, 3).map(tag => (
        <span class="text-[11px] font-mono text-slate-600 dark:text-slate-300 font-medium bg-slate-100 dark:bg-slate-800/80 px-2 py-0.5 rounded-md border border-subtle">
          #{tag}
        </span>
      ))}
    </div>
  )}

  {featured && (
    <div class="pt-2">
      <a href={`/posts/${slug}`} class="text-xs font-semibold text-accent-primary dark:text-accent-primaryDark hover:underline inline-flex items-center gap-1 group/link">
        Read post &rarr;
      </a>
    </div>
  )}
</article>
