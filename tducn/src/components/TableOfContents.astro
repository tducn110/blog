---
// ponytail: Click-to-Expand Smart Table of Contents (Zero scroll distraction, Click-only reveal)
import { Bookmark, ChevronDown } from 'lucide-astro';

interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{toc.length > 0 && (
  <nav
    class="card-surface shadow-sm hover:shadow-md border border-subtle rounded-2xl transition-all duration-200 select-none toc-is-collapsed"
    aria-label="Table of Contents"
    id="article-toc"
  >
    <!-- Clickable Header: Toggles TOC on click, completely quiet while reading/scrolling -->
    <div
      id="toc-header"
      class="flex items-center justify-between p-4 cursor-pointer hover:bg-slate-50/60 dark:hover:bg-slate-800/40 rounded-2xl transition-colors"
      role="button"
      tabindex="0"
      aria-expanded="false"
      aria-controls="toc-content"
    >
      <div class="flex items-center gap-2 text-xs font-bold text-text-main">
        <Bookmark class="w-3.5 h-3.5 text-accent-primary dark:text-accent-primaryDark shrink-0" />
        <span>Table of Contents</span>
        <span class="text-[10px] font-mono text-text-muted bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded-full border border-subtle">
          {toc.length}
        </span>
      </div>

      <button
        id="toc-toggle-btn"
        type="button"
        class="text-[11px] font-mono text-text-muted hover:text-text-main bg-slate-100/80 dark:bg-slate-800/80 px-2 py-0.5 rounded-lg flex items-center gap-1 transition-all cursor-pointer border border-subtle"
        aria-expanded="false"
        aria-controls="toc-content"
        title="Click to expand/collapse Table of Contents"
      >
        <span id="toc-toggle-label">Expand</span>
        <ChevronDown id="toc-toggle-icon" class="w-3.5 h-3.5 transition-transform duration-200" />
      </button>
    </div>

    <!-- Collapsible List Container: ONLY visible when explicitly clicked by user -->
    <div id="toc-content" class="px-4 pb-4 pt-1 border-t border-subtle/80 transition-all duration-300">
      <ul
        id="toc-scroll-list"
        class="space-y-1 text-xs text-text-muted max-h-[calc(100vh-16rem)] overflow-y-auto pr-1 py-1 custom-scrollbar"
      >
        {toc.map(item => (
          <li class={item.depth === 3 ? "pl-3 text-[11px]" : ""}>
            <a
              href={`#${item.slug}`}
              data-toc-slug={item.slug}
              class="toc-link block transition-all py-1.5 px-2 rounded-lg hover:text-accent-primary dark:hover:text-accent-primaryDark hover:bg-slate-100/60 dark:hover:bg-slate-800/60"
            >
              {item.text}
            </a>
          </li>
        ))}
      </ul>
      
      <!-- Subtle Helper Note -->
      <div class="pt-2.5 mt-2 border-t border-subtle/60 text-[10px] font-mono text-text-muted/70 flex items-center justify-between">
        <span>Click heading to jump</span>
        <span class="text-accent-primary dark:text-accent-primaryDark">Distraction-free</span>
      </div>
    </div>
  </nav>

  <style>
    /* Collapsed State: Hidden content until user clicks the header area */
    #article-toc.toc-is-collapsed #toc-content {
      display: none;
    }

    #article-toc.toc-is-collapsed #toc-toggle-icon {
      transform: rotate(-90deg);
    }

    /* Scrollbar Styling for TOC */
    .custom-scrollbar::-webkit-scrollbar {
      width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: rgba(150, 150, 150, 0.2);
      border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: rgba(150, 150, 150, 0.4);
    }

    /* Active Heading Link in TOC: High-contrast, prestigious slate/indigo active indicator */
    .toc-link.active {
      color: #0f172a !important;
      font-weight: 700 !important;
      background-color: rgba(99, 102, 241, 0.08) !important;
      border-left: 2.5px solid #6366f1 !important;
      padding-left: 0.65rem !important;
    }
    :global(.dark) .toc-link.active {
      color: #ffffff !important;
      font-weight: 700 !important;
      background-color: rgba(99, 102, 241, 0.14) !important;
      border-left: 2.5px solid #818cf8 !important;
      padding-left: 0.65rem !important;
    }
  </style>

  <script>
    const tocNav = document.getElementById('article-toc');
    const tocHeader = document.getElementById('toc-header');
    const toggleBtn = document.getElementById('toc-toggle-btn');
    const toggleLabel = document.getElementById('toc-toggle-label');
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('#article-toc a[data-toc-slug]');
    const tocScrollList = document.getElementById('toc-scroll-list');

    // State: Default is COLLAPSED so scrolling never shows TOC while reading
    let isExpanded = false;

    function setExpandedState(expanded: boolean) {
      isExpanded = expanded;
      if (!tocNav || !toggleBtn || !toggleLabel || !tocHeader) return;

      if (isExpanded) {
        tocNav.classList.remove('toc-is-collapsed');
        toggleLabel.textContent = 'Collapse';
        toggleBtn.setAttribute('aria-expanded', 'true');
        tocHeader.setAttribute('aria-expanded', 'true');
      } else {
        tocNav.classList.add('toc-is-collapsed');
        toggleLabel.textContent = 'Expand';
        toggleBtn.setAttribute('aria-expanded', 'false');
        tocHeader.setAttribute('aria-expanded', 'false');
      }
    }

    // Toggle on clicking the header or button
    function toggleToc() {
      setExpandedState(!isExpanded);
    }

    tocHeader?.addEventListener('click', (e) => {
      // Avoid double trigger if clicking directly on button
      if (e.target !== toggleBtn && !toggleBtn?.contains(e.target as Node)) {
        toggleToc();
      }
    });

    tocHeader?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggleToc();
      }
    });

    toggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleToc();
    });

    // ScrollSpy: Update active link quietly in background without forcing TOC to show on scroll
    const headingElements = Array.from(tocLinks)
      .map(link => {
        const slug = link.getAttribute('data-toc-slug');
        return slug ? document.getElementById(slug) : null;
      })
      .filter((el): el is HTMLElement => el !== null);

    if (headingElements.length > 0 && tocLinks.length > 0) {
      let activeSlug = '';

      function updateActiveHeading() {
        const scrollPosition = window.scrollY + 120;
        
        let currentHeading: HTMLElement | null = null;
        for (const heading of headingElements) {
          if (heading.offsetTop <= scrollPosition) {
            currentHeading = heading;
          } else {
            break;
          }
        }

        const newActiveSlug = currentHeading ? currentHeading.id : (headingElements[0]?.id || '');
        if (newActiveSlug !== activeSlug) {
          activeSlug = newActiveSlug;
          let activeLinkEl: HTMLAnchorElement | null = null;

          tocLinks.forEach(link => {
            if (link.getAttribute('data-toc-slug') === activeSlug) {
              link.classList.add('active');
              activeLinkEl = link;
            } else {
              link.classList.remove('active');
            }
          });

          // If currently expanded, keep active link in view inside TOC list
          if (isExpanded && activeLinkEl && tocScrollList) {
            const listRect = tocScrollList.getBoundingClientRect();
            const linkRect = (activeLinkEl as HTMLElement).getBoundingClientRect();
            if (linkRect.bottom > listRect.bottom || linkRect.top < listRect.top) {
              (activeLinkEl as HTMLElement).scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            }
          }
        }
      }

      updateActiveHeading();
      window.addEventListener('scroll', updateActiveHeading, { passive: true });

      // Smooth scroll on click and optionally collapse
      tocLinks.forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const slug = link.getAttribute('data-toc-slug');
          if (slug) {
            const target = document.getElementById(slug);
            if (target) {
              const top = target.getBoundingClientRect().top + window.scrollY - 88;
              window.scrollTo({ top, behavior: 'smooth' });
              history.pushState(null, '', `#${slug}`);
            }
          }
        });
      });
    }
  </script>
)}
