---
// ponytail: Interactive Smart Table of Contents with ScrollSpy, Reading Auto-Hide, and Collapse/Expand
import { Bookmark, ChevronDown } from 'lucide-astro';

interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{toc.length > 0 && (
  <nav
    class="card-surface p-5 space-y-3 shadow-md border border-subtle rounded-2xl transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] select-none"
    aria-label="Table of Contents"
    id="article-toc"
  >
    <!-- Header with Section Count & Collapse/Expand Toggle -->
    <div class="flex items-center justify-between border-b border-subtle pb-2.5">
      <div class="flex items-center gap-2 text-xs font-bold text-text-main">
        <Bookmark class="w-3.5 h-3.5 text-accent-primary dark:text-accent-primaryDark shrink-0" />
        <span>Table of Contents</span>
        <span class="text-[10px] font-mono text-text-muted bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded-full border border-subtle">
          {toc.length}
        </span>
      </div>

      <button
        id="toc-toggle-btn"
        type="button"
        class="text-[11px] font-mono text-text-muted hover:text-text-main hover:bg-slate-100 dark:hover:bg-slate-800/80 px-2 py-0.5 rounded-lg flex items-center gap-1 transition-all cursor-pointer"
        aria-expanded="true"
        aria-controls="toc-content"
        title="Toggle Table of Contents"
      >
        <span id="toc-toggle-label">Collapse</span>
        <ChevronDown id="toc-toggle-icon" class="w-3.5 h-3.5 transition-transform duration-200" />
      </button>
    </div>

    <!-- Collapsible List Container with Max-Height & Custom Scrollbar -->
    <div id="toc-content" class="transition-all duration-300">
      <ul
        id="toc-scroll-list"
        class="space-y-1 text-xs text-text-muted max-h-[calc(100vh-14rem)] overflow-y-auto pr-1 py-1 custom-scrollbar"
      >
        {toc.map(item => (
          <li class={item.depth === 3 ? "pl-3 text-[11px]" : ""}>
            <a
              href={`#${item.slug}`}
              data-toc-slug={item.slug}
              class="toc-link block transition-all py-1.5 px-2 rounded-lg hover:text-accent-primary dark:hover:text-accent-primaryDark hover:bg-slate-100/60 dark:hover:bg-slate-800/60"
            >
              {item.text}
            </a>
          </li>
        ))}
      </ul>
      
      <!-- Subtle Reading Helper Footer -->
      <div class="pt-2 border-t border-subtle/60 text-[10px] font-mono text-text-muted/70 flex items-center justify-between">
        <span>Auto-hides while reading</span>
        <span>Scroll up to reveal</span>
      </div>
    </div>
  </nav>

  <style>
    /* Distraction-Free Reading Mode: Hidden on scroll-down */
    #article-toc.toc-reading-hidden {
      opacity: 0;
      transform: translateY(-10px) scale(0.97);
      pointer-events: none;
    }

    /* Manually Collapsed State */
    #article-toc.toc-is-collapsed #toc-content {
      display: none;
    }

    #article-toc.toc-is-collapsed #toc-toggle-icon {
      transform: rotate(-90deg);
    }

    /* Scrollbar Styling for TOC */
    .custom-scrollbar::-webkit-scrollbar {
      width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: rgba(150, 150, 150, 0.2);
      border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: rgba(150, 150, 150, 0.4);
    }

    /* Active Heading Link in TOC */
    .toc-link.active {
      color: var(--color-accent-primary, #ef4444) !important;
      font-weight: 600 !important;
      background-color: rgba(239, 68, 68, 0.08) !important;
    }
    :global(.dark) .toc-link.active {
      color: #f87171 !important;
      background-color: rgba(248, 113, 113, 0.12) !important;
    }
  </style>

  <script>
    const tocNav = document.getElementById('article-toc');
    const toggleBtn = document.getElementById('toc-toggle-btn');
    const toggleLabel = document.getElementById('toc-toggle-label');
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('#article-toc a[data-toc-slug]');
    const tocScrollList = document.getElementById('toc-scroll-list');

    // 1. Manual Collapse / Expand Logic with LocalStorage persistence
    let isCollapsed = localStorage.getItem('blog_toc_collapsed') === 'true';

    function setCollapsedState(collapsed: boolean) {
      isCollapsed = collapsed;
      if (!tocNav || !toggleBtn || !toggleLabel) return;

      if (isCollapsed) {
        tocNav.classList.add('toc-is-collapsed');
        toggleLabel.textContent = 'Expand';
        toggleBtn.setAttribute('aria-expanded', 'false');
      } else {
        tocNav.classList.remove('toc-is-collapsed');
        toggleLabel.textContent = 'Collapse';
        toggleBtn.setAttribute('aria-expanded', 'true');
      }
      localStorage.setItem('blog_toc_collapsed', String(isCollapsed));
    }

    // Initialize from storage
    if (isCollapsed) {
      setCollapsedState(true);
    }

    toggleBtn?.addEventListener('click', () => {
      setCollapsedState(!isCollapsed);
    });

    // 2. Scroll-Aware Distraction-Free Reading Mode (Auto-hide on scroll down, reveal on scroll up)
    let lastScrollY = window.scrollY;
    let isScrollingTicking = false;
    let isHovering = false;

    function handleTocScroll() {
      const currentScrollY = window.scrollY;
      const scrollDiff = currentScrollY - lastScrollY;

      if (!isHovering && tocNav) {
        if (currentScrollY < 140) {
          // Near top of article: always reveal TOC
          tocNav.classList.remove('toc-reading-hidden');
        } else if (scrollDiff > 8 && currentScrollY > 180) {
          // Scrolling DOWN (Active reading): Auto-hide TOC to eliminate visual clutter
          tocNav.classList.add('toc-reading-hidden');
        } else if (scrollDiff < -8) {
          // Scrolling UP (Navigating): Reveal TOC smoothly
          tocNav.classList.remove('toc-reading-hidden');
        }
      }

      lastScrollY = currentScrollY;
      isScrollingTicking = false;
    }

    window.addEventListener('scroll', () => {
      if (!isScrollingTicking) {
        window.requestAnimationFrame(handleTocScroll);
        isScrollingTicking = true;
      }
    }, { passive: true });

    // 3. Hover to Reveal: Moving mouse over TOC container temporarily restores visibility
    tocNav?.parentElement?.addEventListener('mouseenter', () => {
      isHovering = true;
      tocNav?.classList.remove('toc-reading-hidden');
    });

    tocNav?.parentElement?.addEventListener('mouseleave', () => {
      isHovering = false;
      // If currently scrolling down into content, restore hidden reading mode
      if (window.scrollY > 200) {
        tocNav?.classList.add('toc-reading-hidden');
      }
    });

    // 4. ScrollSpy: Dynamic Table of Contents Highlight & Keep in View
    const headingElements = Array.from(tocLinks)
      .map(link => {
        const slug = link.getAttribute('data-toc-slug');
        return slug ? document.getElementById(slug) : null;
      })
      .filter((el): el is HTMLElement => el !== null);

    if (headingElements.length > 0 && tocLinks.length > 0) {
      let activeSlug = '';

      function updateActiveHeading() {
        const scrollPosition = window.scrollY + 120; // 120px offset below header
        
        let currentHeading: HTMLElement | null = null;
        for (const heading of headingElements) {
          if (heading.offsetTop <= scrollPosition) {
            currentHeading = heading;
          } else {
            break;
          }
        }

        const newActiveSlug = currentHeading ? currentHeading.id : (headingElements[0]?.id || '');
        if (newActiveSlug !== activeSlug) {
          activeSlug = newActiveSlug;
          let activeLinkEl: HTMLAnchorElement | null = null;

          tocLinks.forEach(link => {
            if (link.getAttribute('data-toc-slug') === activeSlug) {
              link.classList.add('active');
              activeLinkEl = link;
            } else {
              link.classList.remove('active');
            }
          });

          // Auto-scroll inside TOC if active heading is off-screen
          if (activeLinkEl && tocScrollList) {
            const listRect = tocScrollList.getBoundingClientRect();
            const linkRect = (activeLinkEl as HTMLElement).getBoundingClientRect();
            if (linkRect.bottom > listRect.bottom || linkRect.top < listRect.top) {
              (activeLinkEl as HTMLElement).scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            }
          }
        }
      }

      updateActiveHeading();
      window.addEventListener('scroll', updateActiveHeading, { passive: true });

      // Smooth scroll on click with history state
      tocLinks.forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const slug = link.getAttribute('data-toc-slug');
          if (slug) {
            const target = document.getElementById(slug);
            if (target) {
              const top = target.getBoundingClientRect().top + window.scrollY - 88;
              window.scrollTo({ top, behavior: 'smooth' });
              history.pushState(null, '', `#${slug}`);
            }
          }
        });
      });
    }
  </script>
)}
